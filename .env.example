# Local development configuration only. Never use these sample values in a public deployment.
APP_ENV=development
POSTGRES_USER=queueforge
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_DB=queueforge
AUTH_ENABLED=false
# When AUTH_ENABLED=true, use a unique random value of at least 32 characters.
BOOTSTRAP_API_KEY=
DEFAULT_TENANT_ID=demo
DEFAULT_TENANT_NAME=Nexus Labs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEASE_SECONDS=30
MAX_PAYLOAD_BYTES=65536
MAX_SLEEP_SECONDS=15
